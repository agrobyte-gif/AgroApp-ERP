<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Pantallas propias de Bodega. Misma envoltura que el resto de Agroapp.
    -->

    <!-- ================= BODEGA: EL DIA ================= -->

    <template id="bodega_home" name="Bodega - el dia">
        <t t-call="agrogood_pwa.layout">
            <t t-set="titulo">Bodega</t>

            <a href="/agrogood/bodega/inventario" class="ag-btn ag-btn-ghost">
                Ajustar inventario
            </a>

            <h2 class="ag-h2">Por recibir</h2>
            <t t-if="not recepciones">
                <p class="ag-muted ag-pad">No hay compras esperando.</p>
            </t>
            <t t-foreach="recepciones" t-as="r">
                <a t-att-href="'/agrogood/bodega/recepcion/%s' % r.id" class="ag-card">
                    <div class="ag-card-main">
                        <span class="ag-card-title"><t t-esc="r.partner_id.name or r.name"/></span>
                        <span class="ag-card-sub">
                            <t t-esc="r.name"/> ·
                            <t t-esc="len(r.move_ids)"/> productos
                        </span>
                    </div>
                    <span t-attf-class="ag-chip #{'ag-chip-ok' if r.state == 'assigned' else ''}">
                        <t t-esc="'Listo' if r.state == 'assigned' else 'En camino'"/>
                    </span>
                </a>
            </t>

            <a href="/agrogood/bodega/merma" class="ag-btn ag-btn-warn ag-btn-xl">
                Registrar una merma
            </a>

            <t t-if="preparando">
                <h2 class="ag-h2">Preparandose ahora</h2>
                <t t-foreach="preparando" t-as="s">
                    <div class="ag-card">
                        <div class="ag-card-main">
                            <span class="ag-card-title"><t t-esc="s.partner_id.name"/></span>
                            <span class="ag-card-sub">
                                <t t-esc="s.picker_id.name"/> ·
                                <t t-esc="s.line_count"/> lineas
                            </span>
                        </div>
                        <span t-attf-class="ag-chip #{'ag-chip-warn' if s.state == 'in_progress' else ''}">
                            <t t-esc="'En curso' if s.state == 'in_progress' else 'Sin empezar'"/>
                        </span>
                    </div>
                </t>
            </t>

            <t t-if="por_vencer">
                <h2 class="ag-h2">Lo que vence antes</h2>
                <t t-foreach="por_vencer" t-as="l">
                    <div class="ag-card">
                        <div class="ag-card-main">
                            <span class="ag-card-title"><t t-esc="l.product_id.name"/></span>
                            <span class="ag-card-sub">
                                lote <t t-esc="l.name"/>
                            </span>
                        </div>
                        <span class="ag-chip ag-chip-soft">
                            <t t-esc="l.expiration_date and l.expiration_date.strftime('%d/%m') or ''"/>
                        </span>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- ================= BODEGA: RECIBIR ================= -->
    <!--
        Cantidad, lote y vencimiento en la misma fila. En Odoo estandar el lote
        vive en otra pestana y una fecha de caducidad exige abrir la linea: se
        recibe con el camion del proveedor esperando, y lo que cuesta tres
        pantallas acaba anotandose en un papel "para despues".
    -->

    <template id="bodega_recepcion" name="Bodega - recibir">
        <t t-call="agrogood_pwa.layout">
            <t t-set="titulo">Recibir</t>
            <t t-set="volver">/agrogood/bodega</t>

            <div class="ag-head-block">
                <div class="ag-client"><t t-esc="picking.partner_id.name or 'Sin proveedor'"/></div>
                <div class="ag-muted">
                    <t t-esc="picking.name"/>
                    <t t-if="picking.origin"> · <t t-esc="picking.origin"/></t>
                </div>
            </div>

            <p class="ag-muted ag-pad">
                Corrige la cantidad si llego menos. Lo que falte se sigue
                debiendo al proveedor.
            </p>

            <t t-foreach="lineas" t-as="m">
                <div class="ag-line" t-att-data-move="m.id"
                     t-att-data-lote="'1' if m.product_id.tracking == 'lot' else '0'">
                    <div class="ag-line-head">
                        <span class="ag-line-name"><t t-esc="m.product_id.name"/></span>
                        <span class="ag-uom"><t t-esc="m.product_uom.name"/></span>
                    </div>
                    <div class="ag-muted">
                        pedido: <t t-esc="'{:g}'.format(m.product_uom_qty)"/>
                        <t t-if="m.product_id.default_code">
                            · <t t-esc="m.product_id.default_code"/>
                        </t>
                    </div>

                    <div class="ag-qty-row">
                        <input type="number" class="ag-qty ag-recibido"
                               t-att-value="'{:g}'.format(m.product_uom_qty)"
                               min="0" step="0.1" inputmode="decimal"/>
                        <span class="ag-uom">recibido</span>
                    </div>

                    <t t-if="m.product_id.tracking == 'lot'">
                        <div class="ag-lote-row">
                            <input type="text" class="ag-buscar ag-lote"
                                   placeholder="Numero de lote" autocomplete="off"/>
                            <input type="date" class="ag-buscar ag-vence"/>
                        </div>
                        <div class="ag-muted">Lleva control de caducidad.</div>
                    </t>
                </div>
            </t>

            <button class="ag-btn ag-btn-primary ag-btn-xl"
                    t-att-data-picking="picking.id" data-action="recibir">
                Confirmar recepcion
            </button>

            <t t-set="v" t-value="env['agrogood.estaticos'].version(
                'agrogood_pwa/static/src/js/bodega.js')"/>
            <script t-attf-src="/agrogood_pwa/static/src/js/bodega.js?v=#{v}"/>
        </t>
    </template>

    <!-- ================= BODEGA: MERMA ================= -->

    <template id="bodega_merma" name="Bodega - registrar merma">
        <t t-call="agrogood_pwa.layout">
            <t t-set="titulo">Registrar merma</t>
            <t t-set="volver">/agrogood/bodega</t>

            <p class="ag-muted ag-pad">
                El motivo importa: separa lo que hay que reclamarle al proveedor
                de lo que se perdio en casa.
            </p>

            <input type="search" id="q-merma" class="ag-buscar"
                   placeholder="Buscar producto" autocomplete="off"/>
            <div id="lista-merma"></div>

            <div id="merma-form" class="ag-oculto">
                <div class="ag-head-block">
                    <div class="ag-client" id="merma-producto"></div>
                    <div class="ag-muted" id="merma-stock"></div>
                </div>

                <div class="ag-qty-row">
                    <input type="number" id="merma-qty" class="ag-qty"
                           min="0" step="0.1" inputmode="decimal" placeholder="0"/>
                    <span class="ag-uom" id="merma-uom"></span>
                </div>

                <!-- Solo para productos con caducidad. Se ordenan por fecha:
                     lo que se merma es casi siempre lo mas viejo. -->
                <div id="merma-lote-caja" class="ag-oculto">
                    <select id="merma-lote" class="ag-buscar">
                        <option value="">De que lote</option>
                    </select>
                </div>

                <select id="merma-motivo" class="ag-buscar">
                    <option value="">Por que se perdio</option>
                    <option value="expired">Vencido</option>
                    <option value="damaged">Danado en bodega</option>
                    <option value="damaged_transport">Danado en transporte</option>
                    <option value="quality">Calidad insuficiente</option>
                    <option value="supplier">Llego mal del proveedor</option>
                    <option value="customer_refused">Rechazado por el cliente</option>
                    <option value="inventory_diff">Diferencia de inventario</option>
                    <option value="other">Otro</option>
                </select>

                <!-- Solo aparece con los motivos que se pueden reclamar. Pedir
                     siempre un responsable para una merma por vencimiento es
                     una pregunta sin respuesta, y las preguntas sin respuesta
                     se contestan con cualquier cosa. -->
                <div id="merma-responsable-caja" class="ag-oculto">
                    <select id="merma-responsable" class="ag-buscar">
                        <option value="">A quien se le reclama</option>
                    </select>
                    <div class="ag-muted">
                        Esta perdida es reclamable: sin responsable se asume y
                        ya no se recupera.
                    </div>
                </div>

                <textarea id="merma-nota" class="ag-note-box"
                          placeholder="Detalle (opcional)"/>

                <button class="ag-btn ag-btn-warn ag-btn-xl" data-action="merma">
                    Registrar merma
                </button>
            </div>

            <t t-set="v" t-value="env['agrogood.estaticos'].version(
                'agrogood_pwa/static/src/js/bodega.js')"/>
            <script t-attf-src="/agrogood_pwa/static/src/js/bodega.js?v=#{v}"/>
        </t>
    </template>

    <!-- ============ BODEGA: AJUSTE DE INVENTARIO ============ -->
    <!--
        Se cuenta un producto y se deja lo que dice el sistema igual a lo que
        hay en el estante. Sirve para las cuadraturas y para corregir un error
        de recepcion sin esperar a sentarse.

        El motivo es obligatorio. Un ajuste es dinero que aparece o desaparece
        del balance sin que nadie haya comprado ni vendido: sin explicacion, en
        la cuadratura del mes nadie puede decir si fue merma, error de
        recepcion o robo.
    -->

    <template id="bodega_inventario" name="Bodega - ajustar inventario">
        <t t-call="agrogood_pwa.layout">
            <t t-set="titulo">Ajustar inventario</t>
            <t t-set="volver">/agrogood/bodega</t>

            <input type="search" id="q-producto" class="ag-buscar"
                   placeholder="Buscar producto" autocomplete="off"/>
            <div id="lista-productos"></div>

            <section id="et-contar" class="ag-etapa ag-oculto">
                <div class="ag-head-block">
                    <span class="ag-card-title" id="p-nombre"></span>
                    <span class="ag-card-sub" id="p-actual"></span>
                </div>

                <div id="p-lotes" class="ag-oculto">
                    <label class="ag-h">De que lote</label>
                    <select id="p-lote" class="ag-select"></select>
                </div>

                <label class="ag-h">Cuanto hay de verdad</label>
                <input type="number" id="p-contado" class="ag-qty" step="0.1"
                       min="0" inputmode="decimal"/>
                <div id="p-diferencia" class="ag-muted ag-pad"></div>

                <label class="ag-h">Por que cuadra distinto</label>
                <input type="text" id="p-motivo" class="ag-select"
                       placeholder="Se paso de maduro, llego menos de lo anotado, ..."/>

                <button type="button" id="btn-ajustar"
                        class="ag-btn ag-btn-primary ag-btn-xl">
                    Dejarlo en lo contado
                </button>
                <button type="button" id="btn-otro" class="ag-btn ag-btn-ghost">
                    Contar otro producto
                </button>
            </section>

            <t t-set="v" t-value="env['agrogood.estaticos'].version(
                'agrogood_pwa/static/src/js/bodega_inventario.js')"/>
            <script t-attf-src="/agrogood_pwa/static/src/js/bodega_inventario.js?v=#{v}"/>
        </t>
    </template>

</odoo>
