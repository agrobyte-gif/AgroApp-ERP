<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="import_view_form" model="ir.ui.view">
        <field name="name">agrogood.bank.import.form</field>
        <field name="model">agrogood.bank.import</field>
        <field name="arch" type="xml">
            <form string="Cargar la cartola del banco">
                <group invisible="context.get('agrogood_cargado')">
                    <field name="file" filename="filename"
                           string="Archivo tal como lo exporta el banco"/>
                    <field name="filename" invisible="1"/>
                </group>
                <div class="text-muted" invisible="context.get('agrogood_cargado')">
                    <p>
                        Sirve el archivo tal cual sale de Scotiabank o de
                        Santander, con todas sus hojas. No hay que prepararlo:
                        las columnas se reconocen solas y los cargos se
                        descartan, porque un cargo no lo paga ningun cliente.
                    </p>
                    <p>
                        <strong>El archivo no se guarda.</strong> Lleva RUT,
                        montos y numeros de cuenta de terceros, y de el solo
                        hacen falta los abonos.
                    </p>
                    <p>
                        Subir dos veces la misma cartola no duplica nada.
                    </p>
                </div>

                <field name="result" readonly="1" nolabel="1"
                       widget="text" invisible="not result"/>
                <field name="movement_ids" invisible="1"/>

                <footer>
                    <button name="action_cargar" type="object" string="Cargar"
                            class="btn-primary"
                            invisible="context.get('agrogood_cargado')"/>
                    <button name="action_ver" type="object"
                            string="Ver los abonos" class="btn-primary"
                            invisible="not result"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="import_action" model="ir.actions.act_window">
        <field name="name">Cargar cartola del banco</field>
        <field name="res_model">agrogood.bank.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
