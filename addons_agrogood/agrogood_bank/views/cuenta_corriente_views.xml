<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ LA ORDEN DE COMPRA COMO DOCUMENTO DE COBRO ============ -->

    <record id="sale_order_view_form_cobranza" model="ir.ui.view">
        <field name="name">sale.order.form.agrogood.cobranza</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Cobranza" name="agrogood_cobranza"
                      invisible="state not in ('sale', 'done')">
                    <group>
                        <group string="Documento del SII">
                            <field name="agrogood_sii_folio"
                                   placeholder="Numero emitido en el portal"/>
                            <field name="agrogood_sii_date"/>
                        </group>
                        <group string="Estado del cobro">
                            <field name="agrogood_charge_amount"/>
                            <field name="agrogood_paid_amount"/>
                            <field name="agrogood_due_amount"/>
                            <field name="agrogood_credit_days"/>
                            <field name="agrogood_due_date"/>
                            <field name="agrogood_overdue_days"/>
                            <field name="agrogood_collection_state"/>
                        </group>
                    </group>
                    <field name="agrogood_allocation_ids" readonly="1">
                        <list>
                            <field name="date"/>
                            <field name="movement_id"/>
                            <field name="amount"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                    <p class="text-muted">
                        Se cobra <strong>lo entregado</strong>, no lo pedido: si
                        se pidieron 20 kg y salieron 19,4, se cobran 19,4. La
                        factura se emite en el portal del SII; aqui solo se
                        anota su numero, que es como el cliente se refiere a la
                        deuda cuando se le llama.
                    </p>
                </page>
            </notebook>
        </field>
    </record>

    <record id="sale_order_view_list_cobranza" model="ir.ui.view">
        <field name="name">sale.order.list.agrogood.cobranza</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <list string="Por cobrar" create="false"
                  decoration-danger="agrogood_overdue_days &gt; 0"
                  decoration-muted="agrogood_collection_state == 'paid'">
                <field name="name"/>
                <field name="date_order"/>
                <field name="partner_id"/>
                <field name="agrogood_sii_folio" optional="show"/>
                <field name="agrogood_charge_amount" sum="Entregado"/>
                <field name="agrogood_paid_amount" sum="Pagado" optional="show"/>
                <field name="agrogood_due_amount" sum="Debe"/>
                <field name="agrogood_due_date" optional="show"/>
                <field name="agrogood_overdue_days"/>
                <field name="agrogood_collection_state" widget="badge"
                       decoration-success="agrogood_collection_state == 'paid'"
                       decoration-warning="agrogood_collection_state == 'partial'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="sale_order_view_search_cobranza" model="ir.ui.view">
        <field name="name">sale.order.search.agrogood.cobranza</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="name"/>
                <field name="agrogood_sii_folio"/>
                <filter name="f_por_cobrar" string="Por cobrar"
                        domain="[('agrogood_collection_state', 'in', ('open', 'partial'))]"/>
                <filter name="f_vencidas" string="Vencidas"
                        domain="[('agrogood_due_amount', '&gt;', 0),
                                 ('agrogood_due_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="f_sin_folio" string="Sin folio del SII"
                        domain="[('agrogood_collection_state', '!=', 'nothing'),
                                 ('agrogood_sii_folio', '=', False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="g_cliente" string="Cliente"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="g_estado" string="Estado del cobro"
                            context="{'group_by': 'agrogood_collection_state'}"/>
                    <filter name="g_vence" string="Vencimiento"
                            context="{'group_by': 'agrogood_due_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="orden_cobrar_action" model="ir.actions.act_window">
        <field name="name">Ordenes por cobrar</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('agrogood_collection_state', 'in', ('open', 'partial'))]</field>
        <field name="context">{'create': False}</field>
        <field name="search_view_id" ref="sale_order_view_search_cobranza"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No hay nada por cobrar</p>
            <p>
                Una orden entra aqui cuando se entrega. Se debe lo entregado,
                no lo pedido.
            </p>
        </field>
    </record>

    <!-- La vista de lista propia solo para esta accion, no para todo Ventas. -->
    <record id="orden_cobrar_action_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="sale_order_view_list_cobranza"/>
        <field name="act_window_id" ref="orden_cobrar_action"/>
    </record>

    <!-- ==================== EL SALDO DE CADA CLIENTE ==================== -->

    <record id="partner_view_list_cobranza" model="ir.ui.view">
        <field name="name">res.partner.list.agrogood.cobranza</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Saldos de clientes" create="false"
                  default_order="agrogood_overdue_balance desc, agrogood_balance desc"
                  decoration-danger="agrogood_overdue_balance &gt; 0">
                <field name="display_name" string="Cliente"/>
                <field name="agrogood_open_order_count"/>
                <field name="agrogood_balance" sum="Saldo total"/>
                <field name="agrogood_opening_due" sum="De antes de Agroapp"
                       optional="show"/>
                <field name="agrogood_overdue_balance" sum="Vencido"/>
                <field name="agrogood_oldest_due_days" string="Atraso mas antiguo"/>
                <field name="agrogood_payment_promise_date" string="Dijo que paga el"/>
                <field name="agrogood_payment_promise_note" optional="show"/>
                <field name="agrogood_credit_days" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <button name="action_agrogood_cuenta_corriente" type="object"
                        icon="fa-list" title="Ver su cuenta corriente"/>
            </list>
        </field>
    </record>

    <record id="saldos_action" model="ir.actions.act_window">
        <field name="name">Saldos de clientes</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('agrogood_balance', '&gt;', 0)]</field>
        <field name="context">{'create': False}</field>
        <field name="view_id" ref="partner_view_list_cobranza"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nadie debe nada</p>
            <p>
                El saldo aparece cuando hay ordenes entregadas y no pagadas.
                Ordenado por lo vencido: arriba esta a quien hay que llamar.
            </p>
        </field>
    </record>

    <!-- Y en la ficha del cliente, los dias de plazo y su saldo. -->
    <record id="partner_form_cobranza" model="ir.ui.view">
        <field name="name">res.partner.form.agrogood.cobranza</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_agrogood_cuenta_corriente" type="object"
                        class="oe_stat_button" icon="fa-money"
                        invisible="agrogood_open_order_count == 0"
                        groups="agrogood_base.group_agrogood_sales,agrogood_base.group_agrogood_general_admin">
                    <field name="agrogood_balance" widget="statinfo"
                           string="Saldo"/>
                </button>
            </div>
            <field name="vat" position="after">
                <field name="agrogood_credit_days"
                       groups="agrogood_base.group_agrogood_sales,agrogood_base.group_agrogood_general_admin"/>
                <field name="agrogood_opening_balance"
                       groups="agrogood_base.group_agrogood_general_admin"/>
                <field name="agrogood_opening_date"
                       invisible="not agrogood_opening_balance"
                       groups="agrogood_base.group_agrogood_general_admin"/>
                <field name="agrogood_opening_due" readonly="1"
                       invisible="not agrogood_opening_balance"
                       groups="agrogood_base.group_agrogood_general_admin"/>
                <field name="agrogood_payment_promise_date"
                       invisible="agrogood_balance == 0"
                       groups="agrogood_base.group_agrogood_sales,agrogood_base.group_agrogood_general_admin"/>
                <field name="agrogood_payment_promise_note"
                       invisible="not agrogood_payment_promise_date"
                       groups="agrogood_base.group_agrogood_sales,agrogood_base.group_agrogood_general_admin"/>
            </field>
        </field>
    </record>

</odoo>
