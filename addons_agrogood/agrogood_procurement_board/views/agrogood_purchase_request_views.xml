<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        La pizarra. Un kanban agrupado por estado permite arrastrar la tarjeta
        de una columna a otra, que es exactamente el gesto que se pide: Johan
        mueve "Pendiente" a "En busqueda" sin abrir nada.
        Por eso el estado NO lleva `readonly`: el arrastre lo escribe.
    -->
    <record id="agrogood_purchase_request_view_kanban" model="ir.ui.view">
        <field name="name">agrogood.purchase.request.kanban</field>
        <field name="model">agrogood.purchase.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false"
                    class="o_kanban_small_column" sample="1">
                <field name="state"/>
                <field name="is_late"/>
                <field name="currency_id"/>
                <progressbar field="priority"
                             colors='{"2": "danger", "1": "warning", "0": "muted"}'/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <field name="product_id" class="fw-bold fs-5"/>
                            <field name="priority" widget="priority"/>
                        </div>
                        <div class="mt-1">
                            <field name="qty_requested"/>
                            <field name="product_uom_id"/>
                            <span t-if="record.expected_price.raw_value">
                                &#183; aprox <field name="expected_price"/>
                            </span>
                        </div>
                        <div t-if="record.partner_id.value" class="text-muted">
                            Para <field name="partner_id"/>
                        </div>
                        <div t-if="record.state_note.value" class="fst-italic text-muted mt-1">
                            <field name="state_note"/>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <span>
                                <i class="fa fa-calendar" title="Se necesita para"/>
                                <field name="date_needed"/>
                                <span t-if="record.is_late.raw_value"
                                      class="badge text-bg-danger ms-1">Atrasada</span>
                            </span>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </div>
                        <footer class="pt-0">
                            <field name="name" class="text-muted small"/>
                            <field name="activity_ids" widget="kanban_activity"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="agrogood_purchase_request_view_list" model="ir.ui.view">
        <field name="name">agrogood.purchase.request.list</field>
        <field name="model">agrogood.purchase.request</field>
        <field name="arch" type="xml">
            <list string="Solicitudes de compra"
                  decoration-danger="is_late"
                  decoration-muted="state in ('cancelled', 'rejected')">
                <field name="name"/>
                <field name="priority" widget="priority" optional="show"/>
                <field name="product_id"/>
                <field name="qty_requested"/>
                <field name="product_uom_id" optional="hide"/>
                <field name="partner_id" optional="show"/>
                <field name="date_needed"/>
                <field name="is_late" optional="hide"/>
                <field name="reason" optional="hide"/>
                <field name="supplier_id" optional="show"/>
                <field name="expected_price" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('pending', 'searching', 'quoting')"
                       decoration-success="state in ('purchased', 'received')"
                       decoration-warning="state == 'partial'"
                       decoration-danger="state in ('not_found', 'rejected', 'cancelled')"/>
            </list>
        </field>
    </record>

    <record id="agrogood_purchase_request_view_form" model="ir.ui.view">
        <field name="name">agrogood.purchase.request.form</field>
        <field name="model">agrogood.purchase.request</field>
        <field name="arch" type="xml">
            <form string="Solicitud de compra">
                <header>
                    <button name="action_search" type="object" string="Buscando"
                            invisible="state != 'pending'" class="btn-primary"/>
                    <button name="action_quote" type="object" string="Cotizando"
                            invisible="state not in ('searching',)"/>
                    <button name="action_create_purchase_order" type="object"
                            string="Crear orden de compra" class="btn-primary"
                            invisible="state in ('purchased', 'received', 'cancelled', 'rejected') or purchase_order_id"/>
                    <button name="action_mark_received" type="object" string="Recibido"
                            class="btn-primary" invisible="state not in ('purchased', 'partial')"/>
                    <button name="action_not_found" type="object" string="No encontrado"
                            invisible="state in ('received', 'not_found', 'rejected', 'cancelled')"/>
                    <button name="action_reject" type="object" string="Rechazar"
                            invisible="state in ('received', 'rejected', 'cancelled')"/>
                    <button name="action_cancel" type="object" string="Cancelar"
                            invisible="state in ('received', 'cancelled')"/>
                    <button name="action_reset" type="object" string="Volver a pendiente"
                            invisible="state == 'pending'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,searching,quoting,purchased,received"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_purchase_order" type="object"
                                class="oe_stat_button" icon="fa-shopping-cart"
                                invisible="not purchase_order_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Orden de</span>
                                <span class="o_stat_text">compra</span>
                            </div>
                        </button>
                        <button name="action_view_sale_order" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="not sale_order_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Pedido de</span>
                                <span class="o_stat_text">origen</span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Atrasada" bg_color="text-bg-danger"
                            invisible="not is_late"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Que se necesita">
                            <field name="product_id"/>
                            <label for="qty_requested"/>
                            <div class="o_row">
                                <field name="qty_requested"/>
                                <field name="product_uom_id"/>
                            </div>
                            <field name="expected_price"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="reason"/>
                        </group>
                        <group string="Para quien y cuando">
                            <field name="partner_id"/>
                            <field name="date_needed"/>
                            <field name="priority" widget="priority"/>
                            <field name="is_late" invisible="1"/>
                            <field name="sale_order_id" invisible="not sale_order_id"/>
                            <field name="sale_order_line_id" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Gestion">
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="requested_by_id"/>
                            <field name="supplier_id"
                                   options="{'no_quick_create': True}"/>
                            <field name="qty_purchased"
                                   invisible="state not in ('purchased', 'partial', 'received')"/>
                            <field name="purchase_order_id" invisible="not purchase_order_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Respuesta de Compras">
                            <field name="state_note" nolabel="1" colspan="2"
                                   placeholder="Donde se consiguio, por que no se encontro, a que precio..."/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Observaciones" name="note">
                            <field name="note" placeholder="Contexto de la solicitud"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="agrogood_purchase_request_view_search" model="ir.ui.view">
        <field name="name">agrogood.purchase.request.search</field>
        <field name="model">agrogood.purchase.request</field>
        <field name="arch" type="xml">
            <search string="Solicitudes de compra">
                <field name="name"/>
                <field name="product_id"/>
                <field name="partner_id"/>
                <field name="supplier_id"/>
                <field name="user_id"/>
                <separator/>
                <filter name="abiertas" string="Abiertas"
                        domain="[('state', 'not in', ('received', 'not_found', 'rejected', 'cancelled'))]"/>
                <filter name="atrasadas" string="Atrasadas" domain="[('is_late', '=', True)]"/>
                <filter name="urgentes" string="Urgentes" domain="[('priority', '=', '2')]"/>
                <separator/>
                <filter name="mias" string="Asignadas a mi" domain="[('user_id', '=', uid)]"/>
                <filter name="pedidas_por_mi" string="Solicitadas por mi"
                        domain="[('requested_by_id', '=', uid)]"/>
                <separator/>
                <filter name="para_hoy" string="Para hoy"
                        domain="[('date_needed', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="fecha" string="Se necesita para" date="date_needed"/>
                <group expand="0" string="Agrupar por">
                    <filter name="g_state" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="g_product" string="Producto" context="{'group_by': 'product_id'}"/>
                    <filter name="g_partner" string="Cliente" context="{'group_by': 'partner_id'}"/>
                    <filter name="g_supplier" string="Proveedor" context="{'group_by': 'supplier_id'}"/>
                    <filter name="g_user" string="Responsable" context="{'group_by': 'user_id'}"/>
                    <filter name="g_priority" string="Prioridad" context="{'group_by': 'priority'}"/>
                    <filter name="g_reason" string="Motivo" context="{'group_by': 'reason'}"/>
                    <filter name="g_date" string="Fecha" context="{'group_by': 'date_needed'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="agrogood_purchase_request_action" model="ir.actions.act_window">
        <field name="name">Pizarra de compras</field>
        <field name="res_model">agrogood.purchase.request</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_abiertas': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No hay nada pendiente de conseguir</p>
            <p>Aqui llega lo que hay que comprar: los faltantes que Ventas detecta en
               los pedidos y lo que Logistica pide directamente. Arrastra una tarjeta
               entre columnas para cambiar su estado.</p>
        </field>
    </record>

</odoo>
