<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Categoria propia para que los roles Agrogood no se mezclen con los de Odoo -->
    <record id="module_category_agrogood" model="ir.module.category">
        <field name="name">Agrogood</field>
        <field name="description">Roles operativos y administrativos de la plataforma Agrogood.</field>
        <field name="sequence">5</field>
    </record>

    <!--
        Jerarquia de grupos. Cada modulo agrogood_* declara sus permisos contra
        estos grupos y nunca crea roles paralelos.

        Los grupos se ordenan de menor a mayor alcance. implied_ids expresa la
        herencia: quien tiene el grupo superior obtiene tambien los inferiores.
    -->

    <record id="group_agrogood_picker" model="res.groups">
        <field name="name">Picker</field>
        <field name="category_id" ref="module_category_agrogood"/>
        <field name="comment">Prepara pedidos desde la PWA. Sin acceso al backend.</field>
    </record>

    <record id="group_agrogood_driver" model="res.groups">
        <field name="name">Conductor</field>
        <field name="category_id" ref="module_category_agrogood"/>
        <field name="comment">Ejecuta su ruta del dia desde la PWA. Sin acceso al backend.</field>
    </record>

    <record id="group_agrogood_warehouse" model="res.groups">
        <field name="name">Encargado de Bodega</field>
        <field name="category_id" ref="module_category_agrogood"/>
        <field name="implied_ids" eval="[Command.link(ref('group_agrogood_picker'))]"/>
        <field name="comment">Recepciones, ajustes, mermas e inventarios. Apoya el picking.</field>
    </record>

    <record id="group_agrogood_purchase" model="res.groups">
        <field name="name">Encargado de Compras</field>
        <field name="category_id" ref="module_category_agrogood"/>
        <field name="comment">Pizarra de solicitudes, cotizaciones, ordenes de compra y proveedores.</field>
    </record>

    <record id="group_agrogood_sales" model="res.groups">
        <field name="name">Encargado de Ventas</field>
        <field name="category_id" ref="module_category_agrogood"/>
        <field name="comment">Clientes, pedidos, tarifas, seguimiento comercial y facturacion.</field>
    </record>

    <record id="group_agrogood_logistics_manager" model="res.groups">
        <field name="name">Jefe de Logistica</field>
        <field name="category_id" ref="module_category_agrogood"/>
        <field name="implied_ids" eval="[Command.link(ref('group_agrogood_warehouse'))]"/>
        <field name="comment">Picking, asignacion de Pickers, rutas, conductores y solicitudes de compra.</field>
    </record>

    <record id="group_agrogood_technical_admin" model="res.groups">
        <field name="name">Administrador Tecnico</field>
        <field name="category_id" ref="module_category_agrogood"/>
        <field name="comment">Responsable tecnico de la plataforma: modulos, integraciones y PWA.</field>
    </record>

    <record id="group_agrogood_general_admin" model="res.groups">
        <field name="name">Administrador General</field>
        <field name="category_id" ref="module_category_agrogood"/>
        <field name="implied_ids" eval="[
            Command.link(ref('group_agrogood_logistics_manager')),
            Command.link(ref('group_agrogood_purchase')),
            Command.link(ref('group_agrogood_sales')),
            Command.link(ref('group_agrogood_driver')),
        ]"/>
        <field name="comment">Vision completa de la operacion. No requiere permisos tecnicos.</field>
    </record>

</odoo>
