# Copiar a .env y rellenar. El archivo .env NUNCA se versiona: contiene las
# claves reales del sistema en produccion.
#
#   cp .env.ejemplo .env && nano .env

# Dominio por el que se entra a Agroapp. Debe apuntar (registro A) a la IP
# del servidor ANTES de arrancar: Caddy pide el certificado al iniciar y
# falla si el dominio todavia no resuelve.
DOMINIO=app.agrogood.cl

# Correo al que Let's Encrypt avisa si un certificado va a caducar.
EMAIL_ADMIN=sebastian@agrogood.cl

# Base de datos. Generar con:  openssl rand -base64 24
DB_USER=odoo
DB_PASSWORD=CAMBIAR_POR_CLAVE_LARGA

# Clave maestra de Odoo. Protege crear y borrar bases.
# Generar con:  openssl rand -base64 24
ADMIN_PASSWD=CAMBIAR_POR_CLAVE_LARGA
