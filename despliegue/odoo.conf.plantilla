[options]
; Agroapp - PRODUCCION  (PLANTILLA, no la config final)
;
; Esto NO lo lee Odoo directamente. Odoo no expande variables en el .conf -solo
; en las rutas-, asi que la contrasena maestra puesta como un hueco quedaria
; literal y la clave del .env se ignoraria. entrada.sh rellena los huecos de
; abajo con los secretos del entorno al arrancar el contenedor y genera el
; .conf de verdad. Por eso esto puede vivir en Git: aqui no hay secretos, hay
; huecos.
;
; Las diferencias con desarrollo no son cosmeticas: cambian como aguanta el
; sistema y que puede hacer alguien desde Internet.

admin_passwd = ${ADMIN_PASSWD}
addons_path = /mnt/extra-addons,/usr/lib/python3/dist-packages/odoo/addons
data_dir = /var/lib/odoo

db_host = db
db_port = 5432
db_user = ${DB_USER}
db_password = ${DB_PASSWORD}
db_name = agroapp

; Solo esa base es visible, y el gestor queda desactivado. Un servidor
; expuesto a Internet con el gestor abierto es una invitacion.
dbfilter = ^agroapp$
list_db = False

; Odoo esta detras de Caddy: sin esto generaria enlaces http:// en los correos
; y los documentos.
proxy_mode = True

http_port = 8069
gevent_port = 8072

; Multiproceso. Con 2 nucleos y 4 GB, tres trabajadores es lo que cabe sin que
; el sistema empiece a usar disco como memoria. Cada uno ocupa unos 200 MB.
workers = 3
max_cron_threads = 1

; Limites por peticion. Existen para que una consulta desbocada mate a su
; propio trabajador en lugar de tumbar el servidor entero.
limit_memory_soft = 671088640
limit_memory_hard = 805306368
limit_request = 8192
limit_time_cpu = 120
limit_time_real = 240
limit_time_real_cron = 600

log_level = info
logfile = /var/log/odoo/odoo.log
log_handler = :INFO
logrotate = True
