# Nucleo de Odoo: se clona aparte y nunca se versiona ni se modifica.
odoo-18.0/

# Entorno y datos locales
.venv/
filestore/
logs/
__pycache__/
*.py[cod]

# Configuracion con credenciales reales. Se versiona odoo.conf.example.
config/odoo.conf
# Clave de la cuenta de servicio de Firebase. Es una credencial: quien
# la tenga puede leer y borrar todos los respaldos.
config/firebase-clave.json
# La copia de seguridad que genera configurar_base_datos.ps1 contiene las
# mismas credenciales que odoo.conf.
config/odoo.conf.bak

.idea/
.vscode/
*.log

# Proyecto movil: dependencias y artefactos de compilacion. Se regeneran con
# `npm install` y `npx cap sync`, no tiene sentido versionarlos.
movil/node_modules/
movil/android/build/
movil/android/app/build/
movil/android/.gradle/
movil/android/local.properties
movil/android/capacitor-cordova-android-plugins/
movil/www/logo.png
*.apk

# Despliegue: secretos y respaldos nunca se versionan.
despliegue/.env
despliegue/respaldos/
despliegue/bitacora/

# Datos reales de clientes. Son datos de origen, no codigo: viven en el disco
# y en OneDrive. Meterlos en Git los dejaria en el historial para siempre,
# aunque se borraran despues.
DATOS CLIENTES RUT.xlsx
RUT por completar.xlsx
*.xlsx

# Respaldos locales: contienen la base completa con datos reales de clientes.
respaldos/
